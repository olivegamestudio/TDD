<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
      <!--
        The translations ship as files beside the game rather than compiled in, so a language can be
        corrected, or a new one dropped in, without a rebuild.
      -->
      <None Remove="Text\**\*.json" />
      <Content Include="Text\**\*.json" CopyToOutputDirectory="PreserveNewest" />

      <!--
        Regions ship the same way and for the same reason: a region is authored content, edited by
        a tool rather than written in code, and correcting a marker should not need a rebuild.
      -->
      <None Remove="Regions\**\*.json" />
      <Content Include="Regions\**\*.json" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\BattleForce2249.Abstractions\BattleForce2249.Abstractions.csproj" />
      <ProjectReference Include="..\OliveGameStudio.Localisation\OliveGameStudio.Localisation.csproj" />
      <ProjectReference Include="..\OliveGameStudio.Scenes\OliveGameStudio.Scenes.csproj" />
      <ProjectReference Include="..\OliveGameStudio.World\OliveGameStudio.World.csproj" />
      <ProjectReference Include="..\Pilgrimage\Pilgrimage.csproj" />
    </ItemGroup>

</Project>
